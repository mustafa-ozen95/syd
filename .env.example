# ============================================================================
#  syd (SYD — Switch Yedek Deposu) — kurulum değişkenleri
# ============================================================================
#  docker compose ile:   cp .env.example .env   (izin 600; git'e ve imaja girmez)
#  Bir platformda (Coolify, Dokploy...): bu adları platformun
#  değişken ekranına girin, sırları "gizli" işaretleyin.
#
#  Boş bırakılan satır konteynere BOŞ değer olarak geçer; varsayılanı
#  kullanmak için satırı silin ya da başına # koyun.
# ============================================================================

# ----------------------------------------------------------------------------
#  Uygulama
# ----------------------------------------------------------------------------
#  ⚠ APP_KEY'İ YEDEKLEYİN: oturum çerezleri, şifreli alanlar ve Ayarlar →
#  Veritabanı'nın bağlantı dosyası buna bağlı. Boşsa ilk açılışta üretilir ve
#  storage/app/app-key.txt'de saklanır (günlüğe basılmaz); oradan alıp
#  buraya yazın.
APP_KEY=
APP_URL=https://syd.ornek.test
# APP_NAME=SYD
# APP_TIMEZONE=Europe/Istanbul

# ----------------------------------------------------------------------------
#  Veritabanı
# ----------------------------------------------------------------------------
#  Varsayılan: compose'taki db servisi (MariaDB 11.4). Parolayı siz verin;
#  ilk açılışta kullanıcı ve veritabanı bununla kurulur.
DB_PASSWORD=
# DB_DATABASE=syd
# DB_USERNAME=syd
#
#  Dışarıdaki ya da platformun yönettiği bir MariaDB/MySQL için adresini
#  verin ve db servisini kapatın:
# DB_HOST=
# DB_PORT=3306
# DB_REPLICAS=0

# ----------------------------------------------------------------------------
#  Kimlik Yönetim Merkezi ile giriş (SSO)
# ----------------------------------------------------------------------------
#  IDENTITY_ENABLED=true ise giriş ekranında "merkez ile giriş" düğmesi çıkar.
#  İstemci kimliği ve sırrı merkezdeki "İstemciler" ekranından; dönüş adresi
#  oradaki kayıtla BİREBİR aynı olmalı. Bildirim sırrı boşsa erişim kaldırma
#  ara katmanın beş dakikalık yoklamasını ya da gecelik eşitleme turunu
#  bekler. Merkezin sertifikası genel bir
#  otoriteden değilse kök sertifikası IDENTITY_CA_CERT'a (PEM).
# IDENTITY_ENABLED=false
# IDENTITY_URL=https://kimlik.ornek.test
# IDENTITY_CLIENT_ID=
# IDENTITY_CLIENT_SECRET=
# IDENTITY_REDIRECT_URI=https://syd.ornek.test/login/center/callback
# IDENTITY_NOTIFY_SECRET=
# IDENTITY_NAME="Kimlik Yönetim Merkezi"
# IDENTITY_CA_CERT=

# ----------------------------------------------------------------------------
#  Denetim kaydı
# ----------------------------------------------------------------------------
#  Satırlar HMAC-SHA256 ile zincirlenir. APP_KEY'DEN AYRI TUTUN: boşsa
#  APP_KEY kullanılır ve APP_KEY döndürüldüğü gün bütün geçmiş "kırık"
#  görünür. Üretmek için:
#      openssl rand -hex 32
AUDIT_KEY=

# ----------------------------------------------------------------------------
#  Junos görüntüleri ve switch yedekleri
# ----------------------------------------------------------------------------
#  Switch'in loader'ı görüntüyü bu adresten çeker (bu sunucu, 69/udp).
# JUNOS_TFTP=tftp://192.0.2.5
# TFTP_PORT=69
#
#  Yedekler başka bir FTP'de birikiyorsa (cihazların archive-sites hedefi)
#  swbck-pull onları 5 dakikada bir çeker; hiçbir dosya silinmez.
# SWBCK_PULL_REPLICAS=1
# SWBCK_FTP_HOST=192.0.2.6
# SWBCK_FTP_USER=
# SWBCK_FTP_PASSWORD=

# ----------------------------------------------------------------------------
#  Görünüm
# ----------------------------------------------------------------------------
#  Merkez ve paneller aynı üst alan adındaysa gece/gündüz seçimi paylaşılır.
# THEME_COOKIE_DOMAIN=.ornek.test

# ----------------------------------------------------------------------------
#  Güncelleme kontrolü (Ayarlar → Güncelleme)
# ----------------------------------------------------------------------------
#  Panel her sabah son başarılı imaj derlemesine bakar.
#  Fine-grained jeton: yalnız panel depoları, Contents ve Actions: read.
# UPDATE_TOKEN=
#  Platformun deploy hook adresi: tanımlıysa ve yeni sürüm varsa yönetici
#  "Şimdi güncelle" ile kurulumu başlatır (NineDeploy: Service → Settings →
#  Deploy hook). Adresteki jeton deploy yetkisidir; gizli değişken olarak verin.
# UPDATE_HOOK_URL=

# ----------------------------------------------------------------------------
#  E-posta — "log" seçilirse mailler GÖNDERİLMEZ, yalnızca günlüğe yazılır
# ----------------------------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=syd@ornek.test
# MAIL_FROM_NAME="Switch Yedek Deposu"

# ----------------------------------------------------------------------------
#  Kurulum
# ----------------------------------------------------------------------------
#  Konteyner ve hacim adlarının öneki; aynı sunucuda ikinci kurulumda değişir.
# STACK_PREFIX=syd
#  Deneme ya da taşıma kurulumu: konteynerler cihazlara ve dışarıya bağlanamaz.
# NETWORK_ISOLATED=true
