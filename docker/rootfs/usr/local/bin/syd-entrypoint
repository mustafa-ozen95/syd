#!/bin/bash
# =============================================================================
#  Konteyner başlatıcı
# =============================================================================
#  Sırayla: dizinler → yapılandırma → veritabanı → göçler → süreç yöneticisi.
#
#  Veritabanı ve redis AYRI servislerdir (docker-compose.yml: db, redis);
#  imajda ikisi de yok. Adresleri ortamdan gelir (DB_*, REDIS_*), varsayılan
#  compose'taki servis adları. Panel yalnız HTTP dinler (80): TLS'i önündeki
#  vekil bitirir.
# =============================================================================
set -euo pipefail

UYGULAMA=/uygulama
PHP=/usr/bin/php

bilgi() { printf '\033[1;34m[syd]\033[0m %s\n' "$*"; }
uyari() { printf '\033[1;33m[syd]\033[0m %s\n' "$*" >&2; }
hata()  { printf '\033[1;31m[syd]\033[0m %s\n' "$*" >&2; exit 1; }

# -----------------------------------------------------------------------------
#  1. Çalışma dizinleri
# -----------------------------------------------------------------------------
mkdir -p /run/php
chown syd:syd /run/php

# Çalışma yolları İngilizce adlara geçti: eski hacimdeki adlar açılışta taşınır
# (dizinler OLUŞTURULMADAN önce; yeni ad varsa dokunulmaz, uyarı yazılır;
# bkz. dc-paths).
/usr/local/bin/dc-paths "${UYGULAMA}/storage/app" \
    veritabani=database \
    database/baglanti.json=database/connection.json \
    database/durum.json=database/state.json \
    guncelleme=update \
    update/durum.json=update/state.json \
    ilk-parola.txt=initial-password.txt

mkdir -p "${UYGULAMA}"/storage/{app,logs} \
         "${UYGULAMA}"/storage/framework/{cache/data,sessions,views} \
         "${UYGULAMA}"/bootstrap/cache
chown -R syd:syd "${UYGULAMA}"/storage "${UYGULAMA}"/bootstrap/cache

# Sertifika sekmesinin istek dizini: panel istek.json bırakır, sunucudaki ajan
# okur. Dizin root'a ait gelirse (yeni hacim, chown'suz açılmış host dizini)
# panel yazamaz ve sekme istek bırakamaz. Bağlı değilse dokunulmaz.
if [ -d /etc/dc/sertifika-panel ]; then
    chown syd:syd /etc/dc/sertifika-panel 2>/dev/null && chmod 0750 /etc/dc/sertifika-panel \
        || uyari "/etc/dc/sertifika-panel yazılabilir değil (salt okunur bağlanmış olabilir); Sertifika sekmesi istek bırakamaz."
fi

# -----------------------------------------------------------------------------
#  2. Varsayılanlar
# -----------------------------------------------------------------------------
#  İmajda .env DOSYASI YOKTUR; Laravel ayarları doğrudan ortamdan okur.
#  Buradaki her değer ortamla (docker-compose.yml, .env ya da platformun
#  değişken ekranı) ezilebilir.
#
#  DB_CONNECTION verilmezse Laravel SQLite'a düşer (config/database.php'deki
#  varsayılan hâlâ sqlite) ve göçler dosya bulunamadığı için patlar.
: "${APP_NAME:=SYS}"
: "${APP_ENV:=production}"
: "${APP_DEBUG:=false}"
: "${APP_LOCALE:=tr}"
: "${APP_FALLBACK_LOCALE:=tr}"
: "${APP_TIMEZONE:=Europe/Istanbul}"
: "${LOG_CHANNEL:=stderr}"

: "${DB_CONNECTION:=mysql}"
: "${DB_HOST:=db}"
: "${DB_PORT:=3306}"
: "${DB_DATABASE:=syd}"
: "${DB_USERNAME:=syd}"

# Veritabanı OTURUMUNUN saat dilimi: konteynerin saati (TZ). MariaDB TIMESTAMP
# sütununu oturumun dilimine çevirerek okur ve yazar. İç veritabanı konteynerin
# saatinde çalışır, uzak ya da yönetilen bir sunucu çoğu zaman UTC'de: dilim
# eşitlenmezse taşınan her kayıt 3 saat kaymış okunur ve denetim zinciri kırık
# görünür. Türkiye'de yaz saati yok; sabit fark yeter, sunucuda dilim tablosu
# gerekmez.
: "${DB_TIMEZONE:=$(date +%:z)}"

# Önbellek, oturum ve kuyruk REDIS'te durur (compose: redis servisi).
#
# Uygulamanın kendi .env'i oturumu ve önbelleği VERİTABANINA yazıyordu: her
# istekte SQL, en çok yazılan tablo oturum tablosu ve yedeği gereksiz yere
# şişiren bir hacim.
#
# REDIS_CLIENT phpredis: composer'da predis de var (saf PHP) ama C eklentisi
# imajda kurulu ve her istekte protokolü PHP tarafında çözmüyor.
: "${REDIS_CLIENT:=phpredis}"
: "${REDIS_HOST:=redis}"
: "${CACHE_STORE:=redis}"
: "${SESSION_DRIVER:=redis}"
: "${QUEUE_CONNECTION:=redis}"
: "${FILESYSTEM_DISK:=local}"

# Oturum çerezi varsayılan olarak Secure'dur: panel TLS arkasında durur.
# Düz HTTP ile denemek isteyen bunu bilerek kapatır.
: "${SESSION_SECURE_COOKIE:=true}"

# konteynerde orada bir şey YOK.

export APP_NAME APP_ENV APP_DEBUG APP_LOCALE APP_FALLBACK_LOCALE APP_TIMEZONE \
       APP_URL LOG_CHANNEL TEMA_ALANI DENETIM_ANAHTARI \
       DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD DB_TIMEZONE \
       CACHE_STORE SESSION_DRIVER QUEUE_CONNECTION FILESYSTEM_DISK \
       REDIS_CLIENT REDIS_HOST REDIS_PORT REDIS_PASSWORD \
       SESSION_SECURE_COOKIE

# -----------------------------------------------------------------------------
#  3. APP_KEY
# -----------------------------------------------------------------------------
#  Oturum çerezleri ve şifrelenen her alan bu anahtara bağlıdır. Her açılışta
#  yenisi üretilseydi bir yeniden başlatma bütün oturumları düşürürdü;
#  ilerideki şifreli sütunlar ise okunamaz hâle gelirdi.
#
#  Anahtar HACİMDE saklanır.
ANAHTAR_DOSYASI="${UYGULAMA}/storage/app/app-key.txt"

if [[ -z "${APP_KEY:-}" ]]; then
    if [[ -s "${ANAHTAR_DOSYASI}" ]]; then
        APP_KEY="$(cat "${ANAHTAR_DOSYASI}")"
        export APP_KEY
    else
        APP_KEY="base64:$(head -c 32 /dev/urandom | base64)"
        export APP_KEY

        printf '%s' "${APP_KEY}" > "${ANAHTAR_DOSYASI}"
        chmod 0600 "${ANAHTAR_DOSYASI}"
        chown syd:syd "${ANAHTAR_DOSYASI}"

        # Anahtarın KENDİSİ günlüğe yazılmaz: konteyner günlüğünü okuyabilen
        # (docker logs, platformun günlük ekranı, günlük toplayıcılar)
        # şifreli her alanı açan anahtarı da okurdu. Anahtar zaten 0600 bir
        # dosyada; burada yalnızca nerede olduğu söylenir.
        uyari "════════════════════════════════════════════════════════════════"
        uyari " APP_KEY verilmemişti, üretildi ve saklandı."
        uyari ""
        uyari " Dosya: storage/app/app-key.txt (hacimde durur, restart'ta"
        uyari " yeniden üretilmez). Okumak için:"
        uyari "   docker exec <kapsayıcı> cat /uygulama/storage/app/app-key.txt"
        uyari ""
        uyari " YEDEKLEYİN; ortama (APP_KEY) da yazın."
        uyari "════════════════════════════════════════════════════════════════"
    fi
fi

# -----------------------------------------------------------------------------
#  4. Paneldeki veritabanı ayarı (Ayarlar → Veritabanı)
# -----------------------------------------------------------------------------
#  Panelde uzak bir veritabanı tanımlandıysa bağlantı storage/app/database'de
#  şifreli durur ve yukarıdaki DB_* değerlerini EZER (bkz. ConnectionFile).
#
#  TAŞIMA BURADA YAPILIR, panel çalışmıyorken: kopya alınırken kimse yazmasın
#  diye. Panel isteği bırakıp konteyneri yeniden başlatır (dc-restart);
#  bu açılış ORTAMIN VERDİĞİ veritabanını (DB_*, çoğunlukla compose'taki db
#  servisi) uzak hedefe kopyalar, tablo ve satır sayılarını iki tarafta
#  karşılaştırır ve uzak veritabanıyla devam eder. Bir adım tutmazsa taşıma
#  "basarisiz" yazılır ve panel ortamın veritabanıyla açılır. Kaynağa
#  yazılmaz: taşıma anındaki hâliyle durur.
VT_DIZIN="${UYGULAMA}/storage/app/database"
VT_ASAMA=""
VT_NEDEN=""
VT_OZET=""
declare -A VT_BAG=()

vt() { gosu syd env UYGULAMA="${UYGULAMA}" "${PHP}" /usr/local/bin/dc-database "$@"; }

# Veritabanı bağlantıyı kabul edene kadar bekler (en çok ~3 dk). Seçenek
# dosyası ilk argüman: parola komut satırına girmez.
mariadb_bekle() {
    for _ in $(seq 1 90); do
        mariadb-admin "--defaults-extra-file=$1" --connect-timeout=2 ping --silent >/dev/null 2>&1 && return 0
        sleep 2
    done
    return 1
}

vt_ilk_satir() { head -n 1 "$1" 2>/dev/null | cut -c 1-300; }

# Bağlantıyı VT_BAG'e okur. Değerler base64 gelir: parolada tırnak, boşluk ya
# da satır sonu olabilir ve eval'siz taşımanın güvenli yolu bu.
vt_oku() {
    local satirlar satir
    satirlar="$(vt ortam)" || return 1
    while IFS= read -r satir; do
        [[ -n "${satir}" ]] && VT_BAG["${satir%%=*}"]="$(printf '%s' "${satir#*=}" | base64 -d)"
    done <<< "${satirlar}"
    [[ -n "${VT_BAG[DB_HOST]:-}" && -n "${VT_BAG[DB_DATABASE]:-}" ]]
}

vt_ortama_al() {
    DB_CONNECTION=mysql
    DB_HOST="${VT_BAG[DB_HOST]}"
    DB_PORT="${VT_BAG[DB_PORT]}"
    DB_DATABASE="${VT_BAG[DB_DATABASE]}"
    DB_USERNAME="${VT_BAG[DB_USERNAME]}"
    DB_PASSWORD="${VT_BAG[DB_PASSWORD]}"
    DB_URL=""
    export DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD DB_URL
}

# Tablo başına kesin satır sayısı ("tablo sayı" satırları). Kopya sırasında
# panel kapalı olduğu için iki tarafın çıktısı BİREBİR aynı olmalı.
#
# Sıralama KABUKTA yapılır: MariaDB ile MySQL'in information_schema
# harmanlaması farklı; ORDER BY "jobs" ile "job_batches"ı iki tarafta ters
# dizebilir ve sayılar aynıyken kopya tutmamış görünür.
vt_sayim() {
    local tablolar t n
    tablolar="$(mariadb "$@" -N -B -e "SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE'")" || return 1
    for t in $(LC_ALL=C sort <<< "${tablolar}"); do
        n="$(mariadb "$@" -N -B -e "SELECT COUNT(*) FROM \`${t}\`")" || return 1
        printf '%s %s\n' "${t}" "${n}"
    done
}

vt_kopyala() {
    local kaynak_cnf=$1 cnf=$2 hata=$3 n kaynak hedef
    # Seçenek dosyası İLK argüman olmak zorunda (mariadb istemcisinin kuralı).
    local -a ic=("--defaults-extra-file=${kaynak_cnf}" --connect-timeout=10 "--database=${DB_DATABASE}")
    local -a uzak=("--defaults-extra-file=${cnf}" --connect-timeout=10 "--database=${VT_BAG[DB_DATABASE]}")

    # Kopya yalnızca tabloları taşır. Görünüm, yordam, tetikleyici ve olay
    # tanımlayan kullanıcıya bağlıdır ve hedefte ayrı yetki ister; bu panelde
    # yoklar, olursa eksik bir kopya yerine taşıma yapılmaz.
    n="$(mariadb "${ic[@]}" -N -B -e "SELECT
        (SELECT COUNT(*) FROM information_schema.views WHERE table_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.routines WHERE routine_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.triggers WHERE trigger_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.events WHERE event_schema = DATABASE())" 2>"${hata}")" \
        || { VT_NEDEN="Mevcut veritabanı okunamadı: $(vt_ilk_satir "${hata}")"; return 1; }
    [[ "${n}" == "0" ]] \
        || { VT_NEDEN="Mevcut veritabanında görünüm, yordam, tetikleyici ya da zamanlanmış olay var (${n}); bu taşıma onları kopyalamaz."; return 1; }

    n="$(mariadb "${uzak[@]}" -N -B -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE()" 2>"${hata}")" \
        || { VT_NEDEN="Uzak veritabanına bağlanılamadı: $(vt_ilk_satir "${hata}")"; return 1; }
    [[ "${n}" == "0" ]] \
        || { VT_NEDEN="Uzak veritabanı boş değil (${n} tablo); üzerine yazılmaz."; return 1; }

    # --skip-add-locks: hedef kullanıcıdan LOCK TABLES yetkisi istenmesin.
    # --no-tablespaces: kaynak kullanıcıdan PROCESS yetkisi istenmesin.
    bilgi "Taşıma: kopyalanıyor..."
    if ! mariadb-dump "--defaults-extra-file=${kaynak_cnf}" --single-transaction --skip-add-locks --skip-triggers \
            --no-tablespaces --hex-blob --default-character-set=utf8mb4 "${DB_DATABASE}" 2>"${hata}" \
        | mariadb "${uzak[@]}" --default-character-set=utf8mb4 2>>"${hata}"; then
        VT_NEDEN="Kopya yarıda kaldı: $(vt_ilk_satir "${hata}") Uzak veritabanını boşaltıp yeniden deneyin."
        return 1
    fi

    bilgi "Taşıma: iki tarafta tablo ve satırlar sayılıyor..."
    kaynak="$(vt_sayim "${ic[@]}")" || { VT_NEDEN="Mevcut veritabanında sayım yapılamadı."; return 1; }
    hedef="$(vt_sayim "${uzak[@]}" 2>"${hata}")" || { VT_NEDEN="Uzak veritabanında sayım yapılamadı: $(vt_ilk_satir "${hata}")"; return 1; }
    [[ -n "${kaynak}" && "${kaynak}" == "${hedef}" ]] \
        || { VT_NEDEN="Kopya tutmadı: iki taraftaki tablo ya da satır sayıları farklı. Uzak veritabanını boşaltıp yeniden deneyin."; return 1; }

    VT_OZET="$(awk '{ n++; s += $2 } END { printf "%d tablo, %d satır kopyalandı; iki tarafta sayılar aynı.", n, s }' <<< "${kaynak}")"
}

vt_tasi() {
    local kaynak_cnf=/run/dc-vt-kaynak.cnf cnf=/run/dc-vt-hedef.cnf hata=/run/dc-vt.hata sonuc=0

    vt_oku || { VT_NEDEN="Bağlantı dosyası okunamadı."; return 1; }
    if [[ "${VT_BAG[DB_HOST]}" == "${DB_HOST}" && "${VT_BAG[DB_PORT]}" == "${DB_PORT}" && "${VT_BAG[DB_DATABASE]}" == "${DB_DATABASE}" ]]; then
        VT_NEDEN="Hedef, panelin şu anki veritabanının kendisi (${DB_HOST}:${DB_PORT}/${DB_DATABASE})."
        return 1
    fi
    ( umask 077; vt ortam-istemci > "${kaynak_cnf}" && vt istemci > "${cnf}" ) \
        || { rm -f "${kaynak_cnf}" "${cnf}"; VT_NEDEN="Bağlantı dosyası okunamadı."; return 1; }

    bilgi "Taşıma: mevcut veritabanı bekleniyor (${DB_HOST}:${DB_PORT})..."
    if mariadb_bekle "${kaynak_cnf}"; then
        vt_kopyala "${kaynak_cnf}" "${cnf}" "${hata}" || sonuc=1
    else
        VT_NEDEN="Mevcut veritabanına (${DB_HOST}:${DB_PORT}) bağlanılamadı."
        sonuc=1
    fi
    rm -f "${kaynak_cnf}" "${cnf}" "${hata}"
    return "${sonuc}"
}

# Bu açılış zaten istenen yeniden başlatmadır; kalmış bir istek (konteyner
# döngü görmeden durdurulduysa) bir kez daha boşuna başlatırdı.
rm -f "${VT_DIZIN}/restart"

if [[ -f "${VT_DIZIN}/state.json" ]]; then
    VT_ASAMA="$(vt asama)" || hata "Veritabanı ayarı okunamadı (${VT_DIZIN}/state.json)."
fi

case "${VT_ASAMA}" in
    tasiniyor|deneniyor)
        # Bir önceki açılış taşımanın ortasında kapandı (elle durdurma, elektrik).
        # Panel uzak veritabanına henüz yazmadı; ortamın veritabanıyla devam
        # etmek veri kaybettirmez.
        uyari "Önceki açılış veritabanı taşımasının ortasında kapanmış; ortamın veritabanıyla devam ediliyor."
        vt yaz basarisiz "Önceki açılış taşımanın ortasında kapandı; panel ortamın veritabanıyla açıldı. Uzak veritabanını boşaltıp yeniden deneyin."
        VT_ASAMA=basarisiz
        ;;
    tasinacak)
        bilgi "Veritabanı uzak sunucuya taşınıyor..."
        vt yaz tasiniyor
        if vt_tasi; then
            vt yaz deneniyor "${VT_OZET}"
            VT_ASAMA=deneniyor
            bilgi "Taşıma: ${VT_OZET}"
        else
            uyari "Taşıma yapılmadı: ${VT_NEDEN:-bilinmeyen sebep}"
            vt yaz basarisiz "${VT_NEDEN:-Bilinmeyen sebep.}"
            VT_ASAMA=basarisiz
        fi
        ;;
esac

if [[ "${VT_ASAMA}" == "deneniyor" || "${VT_ASAMA}" == "etkin" ]]; then
    if [[ -z "${VT_BAG[DB_HOST]:-}" ]] && ! vt_oku; then
        # "etkin"de ortamın veritabanına DÖNÜLMEZ: taşıma anında donmuştu.
        [[ "${VT_ASAMA}" == "etkin" ]] \
            && hata "Panel uzak veritabanında ama bağlantı dosyası okunamıyor (APP_KEY değişmiş ya da dosya silinmiş olabilir). Ortamın veritabanı taşıma anındaki hâliyle duruyor; kendiliğinden ona dönülmez."
        vt yaz basarisiz "Bağlantı dosyası okunamadı."
        VT_ASAMA=basarisiz
    else
        vt_ortama_al
        bilgi "Veritabanı: paneldeki ayar (${DB_HOST}:${DB_PORT}/${DB_DATABASE})."
    fi
fi

# -----------------------------------------------------------------------------
#  5. Veritabanını bekle
# -----------------------------------------------------------------------------
#  compose'taki db servisi ilk açılışta veri dizinini kurarken birkaç saniye
#  bağlantı kabul etmez; uzak sunucu ağ ya da bakım yüzünden geç gelebilir.
#  Gelmezse panel açılmaz (çıkış kodu yeniden başlatır): boş bir SQLite'a ya
#  da yanlış yere düşmekten iyidir.
if [[ -z "${DB_PASSWORD:-}" ]]; then
    hata "DB_PASSWORD verilmedi. Veritabanının parolası ortamdan gelir (bkz. .env.example)."
fi
VT_BEKLE_CNF=/run/dc-vt-bekle.cnf
( umask 077; vt ortam-istemci > "${VT_BEKLE_CNF}" ) || hata "Veritabanı bağlantısı hazırlanamadı."
bilgi "Veritabanı bekleniyor (${DB_HOST}:${DB_PORT})..."
mariadb_bekle "${VT_BEKLE_CNF}" || { rm -f "${VT_BEKLE_CNF}"; hata "Veritabanına (${DB_HOST}:${DB_PORT}) bağlanılamadı."; }
rm -f "${VT_BEKLE_CNF}"

# -----------------------------------------------------------------------------
#  6. Göçler ve ilk hesap
# -----------------------------------------------------------------------------
#  --isolated: birden fazla örnek aynı anda kalksa bile göç BİR kez koşar.
#  Kilit ÖNBELLEĞE yazılır; bu tek komut için DOSYA önbelleğine alınır, yoksa
#  ilk açılışta `cache` tablosu henüz yokken göçün kendisi düşerdi.
#
#  Önceki açılışın yapılandırma önbelleği SİLİNİR: konteyner yeniden
#  başladığında bootstrap/cache yerinde kalıyor ve Laravel ortamı değil onu
#  okuyor. Veritabanı taşımasından sonra göçler eski bağlantıya koşardı.
rm -f "${UYGULAMA}/bootstrap/cache/config.php"

bilgi "Göçler çalıştırılıyor..."
if [[ "${VT_ASAMA}" == "deneniyor" ]]; then
    # Uzak veritabanıyla ilk açılış: göçler koşmazsa taşıma geri alınır.
    # Panel bu veritabanına henüz hiç yazmadı; ortamın veritabanına dönmek
    # veri kaybettirmez. Çıkış kodu yeniden başlatmayı tetikler, bir sonraki
    # açılış "basarisiz"ı görüp ortamın veritabanıyla açılır.
    if ! gosu syd env CACHE_STORE=file "${PHP}" artisan migrate --force --isolated; then
        vt yaz basarisiz "Uzak veritabanıyla ilk açılışta göçler koşmadı; panel ortamın veritabanıyla açıldı. Uzak veritabanını boşaltıp yeniden deneyin." || true
        hata "Uzak veritabanında göçler koşmadı; taşıma geri alındı, panel ortamın veritabanıyla yeniden açılacak."
    fi
    vt yaz etkin
    bilgi "Veritabanı taşıması tamamlandı: panel artık uzak veritabanında."
else
    gosu syd env CACHE_STORE=file "${PHP}" artisan migrate --force --isolated
fi

# Bu panelde yerel hesap AÇILMAZ: giriş kimlik merkezinden yapılır ve kimin
# girebileceğine merkez karar verir (bkz. database/seeders/DatabaseSeeder.php).
# Tohum yalnız rol sayısını bildirir; parola üretilmez, dosyaya yazılmaz.
if [[ "$(gosu syd "${PHP}" artisan tinker --execute='echo App\Models\User::query()->count();' 2>/dev/null | tail -1)" == "0" ]]; then
    bilgi "Kullanıcı yok: hesaplar ilk merkez girişinde açılır."
    gosu syd "${PHP}" artisan db:seed --force --class=Database\\Seeders\\DatabaseSeeder
fi

bilgi "Önbellekler üretiliyor..."
gosu syd "${PHP}" artisan optimize

bilgi "Panel hazır."
exec "$@"
