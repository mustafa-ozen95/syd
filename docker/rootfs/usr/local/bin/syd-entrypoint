#!/bin/bash
# =============================================================================
#  Konteyner başlatıcı
# =============================================================================
#  Sırayla: dizinler → yapılandırma → veritabanı → göçler → süreç yöneticisi.
#
#  Veritabanı ve redis AYRI servislerdir (docker-compose.yml: db, redis);
#  imajda ikisi de yok. Adresleri ortamdan gelir (DB_*, REDIS_*), varsayılan
#  compose'taki servis adları. Panel yalnız HTTP dinler (80): TLS'i önündeki
#  vekil bitirir.
# =============================================================================
set -euo pipefail

APP_ROOT=/uygulama
PHP=/usr/bin/php

info() { printf '\033[1;34m[syd]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[syd]\033[0m %s\n' "$*" >&2; }
fail()  { printf '\033[1;31m[syd]\033[0m %s\n' "$*" >&2; exit 1; }

# -----------------------------------------------------------------------------
#  1. Çalışma dizinleri
# -----------------------------------------------------------------------------
mkdir -p /run/php
chown syd:syd /run/php

# Çalışma yolları İngilizce adlara geçti: eski hacimdeki adlar açılışta taşınır
# (dizinler OLUŞTURULMADAN önce; yeni ad varsa dokunulmaz, uyarı yazılır;
# bkz. dc-paths).
/usr/local/bin/dc-paths "${APP_ROOT}/storage/app" \
    veritabani=database \
    database/baglanti.json=database/connection.json \
    database/durum.json=database/state.json \
    guncelleme=update \
    update/durum.json=update/state.json \
    ilk-parola.txt=initial-password.txt

mkdir -p "${APP_ROOT}"/storage/{app,logs} \
         "${APP_ROOT}"/storage/framework/{cache/data,sessions,views} \
         "${APP_ROOT}"/bootstrap/cache
chown -R syd:syd "${APP_ROOT}"/storage "${APP_ROOT}"/bootstrap/cache

# Sertifika sekmesinin istek dizini: panel istek.json bırakır, sunucudaki ajan
# okur. Dizin root'a ait gelirse (yeni hacim, chown'suz açılmış host dizini)
# panel yazamaz ve sekme istek bırakamaz. Bağlı değilse dokunulmaz.
if [ -d /etc/dc/sertifika-panel ]; then
    chown syd:syd /etc/dc/sertifika-panel 2>/dev/null && chmod 0750 /etc/dc/sertifika-panel \
        || warn "/etc/dc/sertifika-panel yazılabilir değil (salt okunur bağlanmış olabilir); Sertifika sekmesi istek bırakamaz."
fi

# -----------------------------------------------------------------------------
#  2. Varsayılanlar
# -----------------------------------------------------------------------------
#  İmajda .env DOSYASI YOKTUR; Laravel ayarları doğrudan ortamdan okur.
#  Buradaki her değer ortamla (docker-compose.yml, .env ya da platformun
#  değişken ekranı) ezilebilir.
#
#  DB_CONNECTION verilmezse Laravel SQLite'a düşer (config/database.php'deki
#  varsayılan hâlâ sqlite) ve göçler dosya bulunamadığı için patlar.
: "${APP_NAME:=SYS}"
: "${APP_ENV:=production}"
: "${APP_DEBUG:=false}"
: "${APP_LOCALE:=tr}"
: "${APP_FALLBACK_LOCALE:=tr}"
: "${APP_TIMEZONE:=Europe/Istanbul}"
: "${LOG_CHANNEL:=stderr}"

: "${DB_CONNECTION:=mysql}"
: "${DB_HOST:=db}"
: "${DB_PORT:=3306}"
: "${DB_DATABASE:=syd}"
: "${DB_USERNAME:=syd}"

# Veritabanı OTURUMUNUN saat dilimi: konteynerin saati (TZ). MariaDB TIMESTAMP
# sütununu oturumun dilimine çevirerek okur ve yazar. İç veritabanı konteynerin
# saatinde çalışır, uzak ya da yönetilen bir sunucu çoğu zaman UTC'de: dilim
# eşitlenmezse taşınan her kayıt 3 saat kaymış okunur ve denetim zinciri kırık
# görünür. Türkiye'de yaz saati yok; sabit fark yeter, sunucuda dilim tablosu
# gerekmez.
: "${DB_TIMEZONE:=$(date +%:z)}"

# Önbellek, oturum ve kuyruk REDIS'te durur (compose: redis servisi).
#
# Uygulamanın kendi .env'i oturumu ve önbelleği VERİTABANINA yazıyordu: her
# istekte SQL, en çok yazılan tablo oturum tablosu ve yedeği gereksiz yere
# şişiren bir hacim.
#
# REDIS_CLIENT phpredis: composer'da predis de var (saf PHP) ama C eklentisi
# imajda kurulu ve her istekte protokolü PHP tarafında çözmüyor.
: "${REDIS_CLIENT:=phpredis}"
: "${REDIS_HOST:=redis}"
: "${CACHE_STORE:=redis}"
: "${SESSION_DRIVER:=redis}"
: "${QUEUE_CONNECTION:=redis}"
: "${FILESYSTEM_DISK:=local}"

# Oturum çerezi varsayılan olarak Secure'dur: panel TLS arkasında durur.
# Düz HTTP ile denemek isteyen bunu bilerek kapatır.
: "${SESSION_SECURE_COOKIE:=true}"

# konteynerde orada bir şey YOK.

export APP_NAME APP_ENV APP_DEBUG APP_LOCALE APP_FALLBACK_LOCALE APP_TIMEZONE \
       APP_URL LOG_CHANNEL THEME_COOKIE_DOMAIN AUDIT_KEY \
       DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD DB_TIMEZONE \
       CACHE_STORE SESSION_DRIVER QUEUE_CONNECTION FILESYSTEM_DISK \
       REDIS_CLIENT REDIS_HOST REDIS_PORT REDIS_PASSWORD \
       SESSION_SECURE_COOKIE

# -----------------------------------------------------------------------------
#  3. APP_KEY
# -----------------------------------------------------------------------------
#  Oturum çerezleri ve şifrelenen her alan bu anahtara bağlıdır. Her açılışta
#  yenisi üretilseydi bir yeniden başlatma bütün oturumları düşürürdü;
#  ilerideki şifreli sütunlar ise okunamaz hâle gelirdi.
#
#  Anahtar HACİMDE saklanır.
KEY_FILE="${APP_ROOT}/storage/app/app-key.txt"

if [[ -z "${APP_KEY:-}" ]]; then
    if [[ -s "${KEY_FILE}" ]]; then
        APP_KEY="$(cat "${KEY_FILE}")"
        export APP_KEY
    else
        APP_KEY="base64:$(head -c 32 /dev/urandom | base64)"
        export APP_KEY

        printf '%s' "${APP_KEY}" > "${KEY_FILE}"
        chmod 0600 "${KEY_FILE}"
        chown syd:syd "${KEY_FILE}"

        # Anahtarın KENDİSİ günlüğe yazılmaz: konteyner günlüğünü okuyabilen
        # (docker logs, platformun günlük ekranı, günlük toplayıcılar)
        # şifreli her alanı açan anahtarı da okurdu. Anahtar zaten 0600 bir
        # dosyada; burada yalnızca nerede olduğu söylenir.
        warn "════════════════════════════════════════════════════════════════"
        warn " APP_KEY verilmemişti, üretildi ve saklandı."
        warn ""
        warn " Dosya: storage/app/app-key.txt (hacimde durur, restart'ta"
        warn " yeniden üretilmez). Okumak için:"
        warn "   docker exec <kapsayıcı> cat /uygulama/storage/app/app-key.txt"
        warn ""
        warn " YEDEKLEYİN; ortama (APP_KEY) da yazın."
        warn "════════════════════════════════════════════════════════════════"
    fi
fi

# -----------------------------------------------------------------------------
#  4. Paneldeki veritabanı ayarı (Ayarlar → Veritabanı)
# -----------------------------------------------------------------------------
#  Panelde uzak bir veritabanı tanımlandıysa bağlantı storage/app/database'de
#  şifreli durur ve yukarıdaki DB_* değerlerini EZER (bkz. ConnectionFile).
#
#  TAŞIMA BURADA YAPILIR, panel çalışmıyorken: kopya alınırken kimse yazmasın
#  diye. Panel isteği bırakıp konteyneri yeniden başlatır (dc-restart);
#  bu açılış ORTAMIN VERDİĞİ veritabanını (DB_*, çoğunlukla compose'taki db
#  servisi) uzak hedefe kopyalar, tablo ve satır sayılarını iki tarafta
#  karşılaştırır ve uzak veritabanıyla devam eder. Bir adım tutmazsa taşıma
#  "basarisiz" yazılır ve panel ortamın veritabanıyla açılır. Kaynağa
#  yazılmaz: taşıma anındaki hâliyle durur.
DB_STATE_DIR="${APP_ROOT}/storage/app/database"
DB_STAGE=""
DB_REASON=""
DB_SUMMARY=""
declare -A DB_CONN=()

dbctl() { gosu syd env APP_ROOT="${APP_ROOT}" "${PHP}" /usr/local/bin/dc-database "$@"; }

# Veritabanı bağlantıyı kabul edene kadar bekler (en çok ~3 dk). Seçenek
# dosyası ilk argüman: parola komut satırına girmez.
mariadb_wait() {
    for _ in $(seq 1 90); do
        mariadb-admin "--defaults-extra-file=$1" --connect-timeout=2 ping --silent >/dev/null 2>&1 && return 0
        sleep 2
    done
    return 1
}

db_first_line() { head -n 1 "$1" 2>/dev/null | cut -c 1-300; }

# Bağlantıyı DB_CONN'e okur. Değerler base64 gelir: parolada tırnak, boşluk ya
# da satır sonu olabilir ve eval'siz taşımanın güvenli yolu bu.
db_read() {
    local lines line
    lines="$(dbctl ortam)" || return 1
    while IFS= read -r line; do
        [[ -n "${line}" ]] && DB_CONN["${line%%=*}"]="$(printf '%s' "${line#*=}" | base64 -d)"
    done <<< "${lines}"
    [[ -n "${DB_CONN[DB_HOST]:-}" && -n "${DB_CONN[DB_DATABASE]:-}" ]]
}

db_to_env() {
    DB_CONNECTION=mysql
    DB_HOST="${DB_CONN[DB_HOST]}"
    DB_PORT="${DB_CONN[DB_PORT]}"
    DB_DATABASE="${DB_CONN[DB_DATABASE]}"
    DB_USERNAME="${DB_CONN[DB_USERNAME]}"
    DB_PASSWORD="${DB_CONN[DB_PASSWORD]}"
    DB_URL=""
    export DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD DB_URL
}

# Tablo başına kesin satır sayısı ("tablo sayı" satırları). Kopya sırasında
# panel kapalı olduğu için iki tarafın çıktısı BİREBİR aynı olmalı.
#
# Sıralama KABUKTA yapılır: MariaDB ile MySQL'in information_schema
# harmanlaması farklı; ORDER BY "jobs" ile "job_batches"ı iki tarafta ters
# dizebilir ve sayılar aynıyken kopya tutmamış görünür.
db_count() {
    local tables t n
    tables="$(mariadb "$@" -N -B -e "SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE'")" || return 1
    for t in $(LC_ALL=C sort <<< "${tables}"); do
        n="$(mariadb "$@" -N -B -e "SELECT COUNT(*) FROM \`${t}\`")" || return 1
        printf '%s %s\n' "${t}" "${n}"
    done
}

db_copy() {
    local source_cnf=$1 cnf=$2 errfile=$3 n source target
    # Seçenek dosyası İLK argüman olmak zorunda (mariadb istemcisinin kuralı).
    local -a local_args=("--defaults-extra-file=${source_cnf}" --connect-timeout=10 "--database=${DB_DATABASE}")
    local -a remote_args=("--defaults-extra-file=${cnf}" --connect-timeout=10 "--database=${DB_CONN[DB_DATABASE]}")

    # Kopya yalnızca tabloları taşır. Görünüm, yordam, tetikleyici ve olay
    # tanımlayan kullanıcıya bağlıdır ve hedefte ayrı yetki ister; bu panelde
    # yoklar, olursa eksik bir kopya yerine taşıma yapılmaz.
    n="$(mariadb "${local_args[@]}" -N -B -e "SELECT
        (SELECT COUNT(*) FROM information_schema.views WHERE table_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.routines WHERE routine_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.triggers WHERE trigger_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.events WHERE event_schema = DATABASE())" 2>"${errfile}")" \
        || { DB_REASON="Mevcut veritabanı okunamadı: $(db_first_line "${errfile}")"; return 1; }
    [[ "${n}" == "0" ]] \
        || { DB_REASON="Mevcut veritabanında görünüm, yordam, tetikleyici ya da zamanlanmış olay var (${n}); bu taşıma onları kopyalamaz."; return 1; }

    n="$(mariadb "${remote_args[@]}" -N -B -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE()" 2>"${errfile}")" \
        || { DB_REASON="Uzak veritabanına bağlanılamadı: $(db_first_line "${errfile}")"; return 1; }
    [[ "${n}" == "0" ]] \
        || { DB_REASON="Uzak veritabanı boş değil (${n} tablo); üzerine yazılmaz."; return 1; }

    # --skip-add-locks: hedef kullanıcıdan LOCK TABLES yetkisi istenmesin.
    # --no-tablespaces: kaynak kullanıcıdan PROCESS yetkisi istenmesin.
    info "Taşıma: kopyalanıyor..."
    if ! mariadb-dump "--defaults-extra-file=${source_cnf}" --single-transaction --skip-add-locks --skip-triggers \
            --no-tablespaces --hex-blob --default-character-set=utf8mb4 "${DB_DATABASE}" 2>"${errfile}" \
        | mariadb "${remote_args[@]}" --default-character-set=utf8mb4 2>>"${errfile}"; then
        DB_REASON="Kopya yarıda kaldı: $(db_first_line "${errfile}") Uzak veritabanını boşaltıp yeniden deneyin."
        return 1
    fi

    info "Taşıma: iki tarafta tablo ve satırlar sayılıyor..."
    source="$(db_count "${local_args[@]}")" || { DB_REASON="Mevcut veritabanında sayım yapılamadı."; return 1; }
    target="$(db_count "${remote_args[@]}" 2>"${errfile}")" || { DB_REASON="Uzak veritabanında sayım yapılamadı: $(db_first_line "${errfile}")"; return 1; }
    [[ -n "${source}" && "${source}" == "${target}" ]] \
        || { DB_REASON="Kopya tutmadı: iki taraftaki tablo ya da satır sayıları farklı. Uzak veritabanını boşaltıp yeniden deneyin."; return 1; }

    DB_SUMMARY="$(awk '{ n++; s += $2 } END { printf "%d tablo, %d satır kopyalandı; iki tarafta sayılar aynı.", n, s }' <<< "${source}")"
}

db_migrate() {
    local source_cnf=/run/dc-db-source.cnf cnf=/run/dc-db-target.cnf errfile=/run/dc-db.err result=0

    db_read || { DB_REASON="Bağlantı dosyası okunamadı."; return 1; }
    if [[ "${DB_CONN[DB_HOST]}" == "${DB_HOST}" && "${DB_CONN[DB_PORT]}" == "${DB_PORT}" && "${DB_CONN[DB_DATABASE]}" == "${DB_DATABASE}" ]]; then
        DB_REASON="Hedef, panelin şu anki veritabanının kendisi (${DB_HOST}:${DB_PORT}/${DB_DATABASE})."
        return 1
    fi
    ( umask 077; dbctl ortam-istemci > "${source_cnf}" && dbctl istemci > "${cnf}" ) \
        || { rm -f "${source_cnf}" "${cnf}"; DB_REASON="Bağlantı dosyası okunamadı."; return 1; }

    info "Taşıma: mevcut veritabanı bekleniyor (${DB_HOST}:${DB_PORT})..."
    if mariadb_wait "${source_cnf}"; then
        db_copy "${source_cnf}" "${cnf}" "${errfile}" || result=1
    else
        DB_REASON="Mevcut veritabanına (${DB_HOST}:${DB_PORT}) bağlanılamadı."
        result=1
    fi
    rm -f "${source_cnf}" "${cnf}" "${errfile}"
    return "${result}"
}

# Bu açılış zaten istenen yeniden başlatmadır; kalmış bir istek (konteyner
# döngü görmeden durdurulduysa) bir kez daha boşuna başlatırdı.
rm -f "${DB_STATE_DIR}/restart"

if [[ -f "${DB_STATE_DIR}/state.json" ]]; then
    DB_STAGE="$(dbctl asama)" || fail "Veritabanı ayarı okunamadı (${DB_STATE_DIR}/state.json)."
fi

case "${DB_STAGE}" in
    tasiniyor|deneniyor)
        # Bir önceki açılış taşımanın ortasında kapandı (elle durdurma, elektrik).
        # Panel uzak veritabanına henüz yazmadı; ortamın veritabanıyla devam
        # etmek veri kaybettirmez.
        warn "Önceki açılış veritabanı taşımasının ortasında kapanmış; ortamın veritabanıyla devam ediliyor."
        dbctl yaz basarisiz "Önceki açılış taşımanın ortasında kapandı; panel ortamın veritabanıyla açıldı. Uzak veritabanını boşaltıp yeniden deneyin."
        DB_STAGE=basarisiz
        ;;
    tasinacak)
        info "Veritabanı uzak sunucuya taşınıyor..."
        dbctl yaz tasiniyor
        if db_migrate; then
            dbctl yaz deneniyor "${DB_SUMMARY}"
            DB_STAGE=deneniyor
            info "Taşıma: ${DB_SUMMARY}"
        else
            warn "Taşıma yapılmadı: ${DB_REASON:-bilinmeyen sebep}"
            dbctl yaz basarisiz "${DB_REASON:-Bilinmeyen sebep.}"
            DB_STAGE=basarisiz
        fi
        ;;
esac

if [[ "${DB_STAGE}" == "deneniyor" || "${DB_STAGE}" == "etkin" ]]; then
    if [[ -z "${DB_CONN[DB_HOST]:-}" ]] && ! db_read; then
        # "etkin"de ortamın veritabanına DÖNÜLMEZ: taşıma anında donmuştu.
        [[ "${DB_STAGE}" == "etkin" ]] \
            && fail "Panel uzak veritabanında ama bağlantı dosyası okunamıyor (APP_KEY değişmiş ya da dosya silinmiş olabilir). Ortamın veritabanı taşıma anındaki hâliyle duruyor; kendiliğinden ona dönülmez."
        dbctl yaz basarisiz "Bağlantı dosyası okunamadı."
        DB_STAGE=basarisiz
    else
        db_to_env
        info "Veritabanı: paneldeki ayar (${DB_HOST}:${DB_PORT}/${DB_DATABASE})."
    fi
fi

# -----------------------------------------------------------------------------
#  5. Veritabanını bekle
# -----------------------------------------------------------------------------
#  compose'taki db servisi ilk açılışta veri dizinini kurarken birkaç saniye
#  bağlantı kabul etmez; uzak sunucu ağ ya da bakım yüzünden geç gelebilir.
#  Gelmezse panel açılmaz (çıkış kodu yeniden başlatır): boş bir SQLite'a ya
#  da yanlış yere düşmekten iyidir.
if [[ -z "${DB_PASSWORD:-}" ]]; then
    fail "DB_PASSWORD verilmedi. Veritabanının parolası ortamdan gelir (bkz. .env.example)."
fi
DB_WAIT_CNF=/run/dc-db-wait.cnf
( umask 077; dbctl ortam-istemci > "${DB_WAIT_CNF}" ) || fail "Veritabanı bağlantısı hazırlanamadı."
info "Veritabanı bekleniyor (${DB_HOST}:${DB_PORT})..."
mariadb_wait "${DB_WAIT_CNF}" || { rm -f "${DB_WAIT_CNF}"; fail "Veritabanına (${DB_HOST}:${DB_PORT}) bağlanılamadı."; }
rm -f "${DB_WAIT_CNF}"

# -----------------------------------------------------------------------------
#  6. Göçler ve ilk hesap
# -----------------------------------------------------------------------------
#  --isolated: birden fazla örnek aynı anda kalksa bile göç BİR kez koşar.
#  Kilit ÖNBELLEĞE yazılır; bu tek komut için DOSYA önbelleğine alınır, yoksa
#  ilk açılışta `cache` tablosu henüz yokken göçün kendisi düşerdi.
#
#  Önceki açılışın yapılandırma önbelleği SİLİNİR: konteyner yeniden
#  başladığında bootstrap/cache yerinde kalıyor ve Laravel ortamı değil onu
#  okuyor. Veritabanı taşımasından sonra göçler eski bağlantıya koşardı.
rm -f "${APP_ROOT}/bootstrap/cache/config.php"

info "Göçler çalıştırılıyor..."
if [[ "${DB_STAGE}" == "deneniyor" ]]; then
    # Uzak veritabanıyla ilk açılış: göçler koşmazsa taşıma geri alınır.
    # Panel bu veritabanına henüz hiç yazmadı; ortamın veritabanına dönmek
    # veri kaybettirmez. Çıkış kodu yeniden başlatmayı tetikler, bir sonraki
    # açılış "basarisiz"ı görüp ortamın veritabanıyla açılır.
    if ! gosu syd env CACHE_STORE=file "${PHP}" artisan migrate --force --isolated; then
        dbctl yaz basarisiz "Uzak veritabanıyla ilk açılışta göçler koşmadı; panel ortamın veritabanıyla açıldı. Uzak veritabanını boşaltıp yeniden deneyin." || true
        fail "Uzak veritabanında göçler koşmadı; taşıma geri alındı, panel ortamın veritabanıyla yeniden açılacak."
    fi
    dbctl yaz etkin
    info "Veritabanı taşıması tamamlandı: panel artık uzak veritabanında."
else
    gosu syd env CACHE_STORE=file "${PHP}" artisan migrate --force --isolated
fi

# Bu panelde yerel hesap AÇILMAZ: giriş kimlik merkezinden yapılır ve kimin
# girebileceğine merkez karar verir (bkz. database/seeders/DatabaseSeeder.php).
# Tohum yalnız rol sayısını bildirir; parola üretilmez, dosyaya yazılmaz.
if [[ "$(gosu syd "${PHP}" artisan tinker --execute='echo App\Models\User::query()->count();' 2>/dev/null | tail -1)" == "0" ]]; then
    info "Kullanıcı yok: hesaplar ilk merkez girişinde açılır."
    gosu syd "${PHP}" artisan db:seed --force --class=Database\\Seeders\\DatabaseSeeder
fi

info "Önbellekler üretiliyor..."
gosu syd "${PHP}" artisan optimize

info "Panel hazır."
exec "$@"
