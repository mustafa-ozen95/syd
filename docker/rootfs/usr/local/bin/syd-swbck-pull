#!/bin/bash
# Switch yedeklerini FTP'den çeker.
#
# Juniper cihazlar yapılandırma yedeklerini ayrı bir FTP sunucusuna yazıyorsa
# (archive-sites), bu betik her turda onları yerel dizine aynalar: yalnız yeni
# ya da değişmiş dosyalar iner ve yerelde HİÇBİR DOSYA SİLİNMEZ (mirror'da
# --delete yok). Kaynak FTP'de silinen bir yedek burada kalır.
#
# Ortam:
#   SWBCK_FTP_ADRES      sunucu, ör. 192.0.2.6
#   SWBCK_FTP_KULLANICI  kullanıcı
#   SWBCK_FTP_PAROLA     parola; komut satırına ve dosyaya yazılmaz
#                        (lftp --env-password, LFTP_PASSWORD'dan okur)
#   SWBCK_HEDEF          yerel dizin (varsayılan /yedekler)
#   SWBCK_ARALIK         turlar arası bekleme, saniye (varsayılan 300: önceki tur
#                        bittikten 5 dk sonra)
#   SWBCK_KURU=1         indirmeden yalnız ne ineceğini listeler, tek tur koşar
set -u

ADRES=${SWBCK_FTP_ADRES:?SWBCK_FTP_ADRES gerekli}
KULLANICI=${SWBCK_FTP_KULLANICI:?SWBCK_FTP_KULLANICI gerekli}
export LFTP_PASSWORD=${SWBCK_FTP_PAROLA:?SWBCK_FTP_PAROLA gerekli}
HEDEF=${SWBCK_HEDEF:-/yedekler}
ARALIK=${SWBCK_ARALIK:-300}
KURU=${SWBCK_KURU:-}

[ -d "$HEDEF" ] && [ -w "$HEDEF" ] || { echo "HATA: $HEDEF yazılabilir bir dizin değil" >&2; exit 1; }

# lftp ayarları: düz FTP, pasif kip, kopmalarda yeniden deneme.
BETIK=$(mktemp)
trap 'rm -f "$BETIK"' EXIT
cat > "$BETIK" <<LFTP
set ftp:ssl-allow no
set ftp:passive-mode on
set ftp:use-mlsd yes
set net:timeout 20
set net:max-retries 3
set net:reconnect-interval-base 10
set mirror:parallel-transfer-count 3
set mirror:use-pget-n 1
set xfer:clobber on
open --env-password -u "$KULLANICI" "$ADRES"
mirror --continue --only-newer --no-perms ${KURU:+--dry-run} ./ "$HEDEF/"
bye
LFTP

while true; do
    basla=$(date +%s)
    once=$(find "$HEDEF" -type f | wc -l)
    if lftp -f "$BETIK"; then sonuc=tamamlandı; else sonuc="HATA: lftp çıkış kodu $?"; fi
    sonra=$(find "$HEDEF" -type f | wc -l)
    echo "$(date '+%F %T') $sonuc · $(( sonra - once )) yeni dosya · toplam $sonra · $(( $(date +%s) - basla )) sn"
    [ -n "$KURU" ] && exit 0
    sleep "$ARALIK"
done
